# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable Key (beginnt mit sb_publishable_) – darf in den Browser, durch RLS geschützt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret Key (beginnt mit sb_secret_) – nur im Backend, nie NEXT_PUBLIC_! Für die Steuerung der Session
SUPABASE_SECRET_KEY=
# Frei wählbares Passwort, das die Leinwand beim ersten "Weiter" abfragt
PRESENTER_KEY=
