# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable Key (beginnt mit sb_publishable_) – darf in den Browser, durch RLS geschützt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret Key (beginnt mit sb_secret_) – nur im Backend, nie NEXT_PUBLIC_! Für die Steuerung der Session
SUPABASE_SECRET_KEY=
# Frei wählbares Passwort, das die Leinwand beim ersten "Weiter" abfragt
PRESENTER_KEY=

# Optional: KI-Momente auf der Leinwand (Spotlight, Themen). Ohne Key läuft alles, nur ohne KI.
# Anthropic Console → API Keys (Key aus einem Workspace). Nur im Backend.
ANTHROPIC_API_KEY=
# Nur nötig, wenn der Key keinem Workspace zugeordnet ist (Console → Workspaces → ID)
ANTHROPIC_WORKSPACE_ID=
# Adresse der Kurs-Website für den Schluss-QR und den Knopf am Handy (z. B. https://…/tag-1)
NEXT_PUBLIC_COURSE_URL=
